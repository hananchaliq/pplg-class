# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONNECTION (Wajib untuk koneksi database utama)
NEXT_PUBLIC_SUPABASE_URL="https://wjntbhdjjdkspigsnbog.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_gPsSBOBhNf-vCUxmXl3dDg_POnAqOl3"

# Opsional: Anon Key / Service Role Key standar Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# DATABASE_URL: Koneksi PostgreSQL langsung (Supabase Transaction/Session Pooler atau Direct URI)
# Digunakan oleh aplikasi web untuk membuat tabel, foreign key, dan policy RLS secara otomatis (DDL Auto-Migration).
DATABASE_URL=""

# Kode sandi pengurus admin & kode kelas pengiriman form
