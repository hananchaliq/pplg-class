# ==============================================================================
# VERCEL BLOB STORAGE (Wajib untuk penyimpanan foto & manifest.json real-time)
# ==============================================================================
# Cara mengaktifkan di Dashboard Vercel:
# 1. Buka project Anda di https://vercel.com/dashboard
# 2. Masuk ke tab "Storage" -> klik "Create Database" -> pilih "Blob"
# 3. Hubungkan (Connect) store Blob ke project ini (Production, Preview, Dev)
# 4. Vercel akan otomatis mengisi variabel BLOB_READ_WRITE_TOKEN di Environment Variables.
#    Untuk pengembangan lokal, salin token dari menu Storage -> .env.local -> "Show Secret"
#    atau jalankan `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_ISI_DENGAN_TOKEN_DARI_VERCEL_STORAGE"

# ==============================================================================
# AUTENTIKASI ADMIN & KODE KELAS XII PPLG 1
# ==============================================================================
# Kode sandi login Dasbor Admin (/admin) & otorisasi endpoint /api/upload
ADMIN_PASSCODE="GANTI_DENGAN_SANDI_ADMIN_YANG_KUAT"
# Kode verifikasi pengiriman form siswa (Galeri, Buku Kenangan, Dream Board, Karya)
CLASS_PASSCODE="GANTI_DENGAN_KODE_KELAS_RAHASIA"
